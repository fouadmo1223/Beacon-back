# ─────────────────────────────────────────────────────────────
# Beacon push server — copy to `.env` and fill in the values.
# Never commit `.env`. These values must NEVER be placed in the
# mobile app or dashboard bundles.
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma separated origins allowed to call the API from a browser (the dashboard).
CORS_ORIGINS=http://localhost:5173

# REQUIRED. Secret the dashboard operator enters in Settings → "Admin API key".
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace-with-a-long-random-secret

# Optional. Only needed when "Enhanced push security" is enabled for your Expo project
# (https://expo.dev/settings/access-tokens).
EXPO_ACCESS_TOKEN=

# PostgreSQL connection string (e.g. Neon: Project → Connect → pooled connection string).
# When set, all data is stored in Postgres and migrations run automatically on boot.
# Use sslmode=verify-full, e.g. postgresql://user:pass@host/db?sslmode=verify-full
DATABASE_URL=

# Fallback when DATABASE_URL is empty: JSON file dev database. Leave empty to keep data in memory only.
DATA_FILE=./data/db.json

# How often the scheduler checks for due notifications / push receipts (ms).
SCHEDULER_INTERVAL_MS=15000
# Expo recommends reading push receipts ~15 minutes after sending (ms).
RECEIPT_CHECK_DELAY_MS=900000

# Set to true when running behind a reverse proxy (correct client IPs for rate limiting).
TRUST_PROXY=false

# debug | info | warn | error
LOG_LEVEL=info
